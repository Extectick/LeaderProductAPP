{
  "name": "extectick-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env NODE_ENV=development expo start",
    "prestart:dev-client": "node ./scripts/freeExpoPort.js 8081",
    "start:dev-client": "cross-env NODE_ENV=development expo start --dev-client --host lan",
    "logs:android": "adb logcat ReactNativeJS:V ReactNative:V Expo:V AndroidRuntime:E *:S",
    "start:prod": "cross-env NODE_ENV=production expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "cross-env NODE_ENV=production expo export --platform web",
    "release:set-version": "node ./scripts/setNativeVersion.js",
    "release:check-version": "node ./scripts/checkNativeVersion.js",
    "release:read-version": "node ./scripts/readNativeVersion.js",
    "release:bump-apk": "node ./scripts/bumpNativeVersion.js",
    "release:check-strategy": "node ./scripts/checkReleaseStrategy.js",
    "native:verify-prebuild": "node ./scripts/verifyLeaderNativeTrackingPrebuild.js",
    "updates:publish-local": "node ./scripts/publishApkUpdateLocal.js",
    "ota:create-metadata": "node ./scripts/createOtaMetadata.js",
    "ota:upload-s3": "node ./scripts/uploadOtaToS3.js",
    "ota:publish-local": "node ./scripts/publishOtaUpdateLocal.js",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js",
    "check:no-legacy-types-imports": "node ./scripts/checkLegacyTypesImports.js",
    "check:sentry-config": "node ./scripts/checkSentryConfig.js",
    "postinstall": "node ./scripts/patchExpoTaskManager.js"
  },
