{
  "name": "extectick-app",
  "main": "index.js",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-blur",
          "expo-camera"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env NODE_ENV=development expo start",
    "prestart:dev-client": "node ./scripts/freeExpoPort.js 8081",
    "start:dev-client": "node ./scripts/devClient.js start",
    "build:dev-client": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-dev-client.ps1",
    "logs:android": "adb logcat ReactNativeJS:V ReactNative:V Expo:V AndroidRuntime:E *:S",
    "qa:help:inspect": "node ./scripts/help-ui-diagnostics.mjs",
    "qa:admin": "node ./scripts/admin-preview.cjs",
    "qa:admin:web": "node ./scripts/admin-preview.cjs --web",
    "qa:admin:history": "node ./scripts/createAdminReleaseHistory.cjs",
    "build:admin-preview": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-admin-preview.ps1",
    "qa:knowledge": "npm --prefix qa/knowledge-preview start",
    "start:prod": "cross-env NODE_ENV=production expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "cross-env NODE_ENV=production expo export --platform web",
    "release:set-version": "node ./scripts/setNativeVersion.js",
    "release:check-version": "node ./scripts/checkNativeVersion.js",
    "release:read-version": "node ./scripts/readNativeVersion.js",
    "release:bump-apk": "node ./scripts/bumpNativeVersion.js",
    "release:check-strategy": "node ./scripts/checkReleaseStrategy.js",
    "native:verify-prebuild": "node ./scripts/verifyLeaderNativeTrackingPrebuild.js",
    "updates:publish-local": "node ./scripts/publishApkUpdateLocal.js",
    "ota:create-metadata": "node ./scripts/createOtaMetadata.js",
    "ota:upload-s3": "node ./scripts/uploadOtaToS3.js",
    "ota:publish-local": "node ./scripts/publishOtaUpdateLocal.js",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js",
    "check:no-legacy-types-imports": "node ./scripts/checkLegacyTypesImports.js",
    "check:sentry-config": "node ./scripts/checkSentryConfig.js",
    "postinstall": "node ./scripts/patchExpoTaskManager.js && node ./scripts/patchExpoBlur.js && node ./scripts/patchExpoCamera.js",
    "build:dev-client:linux": "bash ./scripts/build-dev-client.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kesha-antonov/react-native-background-downloader": "^4.7.0",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-table": "^9.3.1",
    "@tma.js/sdk": "^3.3.0",
    "@wuba/react-native-echarts": "3.1.1",
    "axios": "^1.21.0",
    "babel-preset-expo": "~58.0.24",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "echarts": "6.1.0",
    "expo": "^58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-background-task": "~58.0.12",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "fast-deep-equal": "^3.1.3",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "^6.16.0",
    "markdown-it": "15.0.3",
    "material-react-table": "^3.2.1",
    "moti": "^0.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mask-input": "^1.2.3",
    "react-native-mask-text": "^0.15.0",
    "react-native-pager-view": "9.0.7",
    "react-native-paper": "^5.15.4",
    "react-native-qrcode-svg": "^6.3.52",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "^0.18.3",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-traccar-client-sdk": "^1.1.4",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "ws": "8.22.1"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "unrs-resolver@1.12.2": true
  }
}
